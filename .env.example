NODE_ENV=development
GUILDGATE_ENVIRONMENT=development
GUILDGATE_BASE_URL=http://localhost:3000
GUILDGATE_ALLOWED_ORIGINS=http://localhost:3000

BOT_OWNER_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_USER_ID=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Generate separate random values. Do not reuse one secret for each field.
GUILDGATE_CSRF_SECRET=
GUILDGATE_AUDIT_IP_SALT=

# Base64-encoded 32-byte key used by createTokenCipher().
GUILDGATE_TOKEN_KEY_BASE64=

# Optional Redis connection used by the example application.
REDIS_URL=redis://127.0.0.1:6379
