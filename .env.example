NODE_ENV=development
GUILDGATE_ENVIRONMENT=development
GUILDGATE_BASE_URL=http://localhost:3000
GUILDGATE_ALLOWED_ORIGINS=http://localhost:3000

BOT_OWNER_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_USER_ID=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Generate separate values. Do not reuse one value for each field.
GUILDGATE_CSRF_SECRET=
GUILDGATE_AUDIT_IP_SALT=

# Base64-encoded 32-byte key for createTokenCipher().
GUILDGATE_TOKEN_KEY_BASE64=

# Optional shared stores.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379
GUILDGATE_POSTGRES_PREFIX=guildgate

# Monitoring and realtime defaults owned by the application.
GUILDGATE_METRIC_INTERVAL_MS=30000
GUILDGATE_METRIC_RETENTION_DAYS=30
GUILDGATE_REALTIME_HEARTBEAT_MS=25000
GUILDGATE_REALTIME_REPLAY_LIMIT=500
GUILDGATE_OUTBOX_WORKER_ID=
